{
  "id": "firefly-iii-6",
  "group": "firefly-iii",
  "name": "Firefly III",
  "version": "6",
  "category": "Finanzen",
  "icon": "🔥",
  "summary": "Persönliche Finanzverwaltung mit Konten und Budgets",
  "description": "",
  "runtime": "docker",
  "image": "fireflyiii/core:version-6.6.6",
  "container_port": 8080,
  "protocol": "tcp",
  "http": true,
  "default_exposure": "external",
  "data": {
    "container_path": "/var/www/html/storage/upload",
    "label": "Anhänge + Uploads"
  },
  "env": {
    "TZ": "Europe/Berlin",
    "APP_URL": "https://{domain}",
    "TRUSTED_PROXIES": "**"
  },
  "database": {
    "default": "mariadb",
    "choices": [
      "mariadb"
    ],
    "env": {
      "mariadb": {
        "DB_CONNECTION": "mysql",
        "DB_HOST": "{db_host}",
        "DB_PORT": "3306",
        "DB_DATABASE": "{db_name}",
        "DB_USERNAME": "{db_user}",
        "DB_PASSWORD": "{db_password}"
      }
    }
  },
  "fields": {
    "required": [
      {
        "key": "app_key",
        "label": "App-Schlüssel",
        "type": "password",
        "required": false,
        "generate": true,
        "auto": "password",
        "help": "Interner Verschlüsselungsschlüssel (32 Zeichen) — wird automatisch erzeugt.",
        "target": {
          "kind": "env",
          "name": "APP_KEY",
          "format": "{value:x<32}"
        }
      }
    ],
    "specific": []
  },
  "advanced": {},
  "notes": [
    "Beim ersten Aufruf ein Konto registrieren — der erste Benutzer wird Administrator.",
    "Wiederkehrende Buchungen brauchen einen regelmäßigen Cron-Aufruf (Einstellungen → Automatisierung) — ohne ihn laufen sie nicht automatisch."
  ],
  "audience": "server"
}