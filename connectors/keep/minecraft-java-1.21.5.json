{
  "id": "minecraft-java-1.21.5",
  "group": "minecraft-java",
  "name": "Minecraft (Java)",
  "version": "1.21.5",
  "category": "Spiele",
  "icon": "⛏️",
  "summary": "Minecraft-Server mit Plugins",
  "description": "",
  "runtime": "docker",
  "image": "itzg/minecraft-server:java21",
  "container_port": 25565,
  "protocol": "tcp",
  "http": false,
  "data": {
    "container_path": "/data",
    "label": "Weltdaten"
  },
  "env": {
    "EULA": "TRUE",
    "TYPE": "PAPER",
    "VERSION": "1.21.5",
    "USE_AIKAR_FLAGS": "true"
  },
  "fields": {
    "required": [
      {
        "key": "ram_gb",
        "label": "RAM (GB)",
        "type": "number",
        "default": 4,
        "min": 1,
        "max": 64,
        "required": true,
        "help": "Arbeitsspeicher für die Java-VM des Servers.",
        "target": {
          "kind": "env",
          "name": "MEMORY",
          "format": "{value}G"
        }
      },
      {
        "key": "max_players",
        "label": "Max. Spieler",
        "type": "number",
        "default": 20,
        "min": 1,
        "max": 500,
        "required": true,
        "target": {
          "kind": "file_line",
          "file": "/data/server.properties",
          "prefix": "max-players="
        }
      }
    ],
    "specific": [
      {
        "key": "motd",
        "label": "MOTD (Server-Beschreibung)",
        "type": "string",
        "default": "Ein weblab Server",
        "help": "Text in der Serverliste des Spielers.",
        "target": {
          "kind": "file_line",
          "file": "/data/server.properties",
          "prefix": "motd="
        }
      },
      {
        "key": "gamemode",
        "label": "Spielmodus",
        "type": "select",
        "default": "survival",
        "options": [
          "survival",
          "creative",
          "adventure",
          "spectator"
        ],
        "target": {
          "kind": "file_line",
          "file": "/data/server.properties",
          "prefix": "gamemode="
        }
      },
      {
        "key": "difficulty",
        "label": "Schwierigkeit",
        "type": "select",
        "default": "normal",
        "options": [
          "peaceful",
          "easy",
          "normal",
          "hard"
        ],
        "target": {
          "kind": "file_line",
          "file": "/data/server.properties",
          "prefix": "difficulty="
        }
      },
      {
        "key": "pvp",
        "label": "PvP erlauben",
        "type": "bool",
        "default": true,
        "target": {
          "kind": "file_line",
          "file": "/data/server.properties",
          "prefix": "pvp="
        }
      },
      {
        "key": "online_mode",
        "label": "Online-Modus (Mojang-Auth)",
        "type": "bool",
        "default": true,
        "help": "Aus = auch Offline-Accounts dürfen joinen (unsicher).",
        "target": {
          "kind": "file_line",
          "file": "/data/server.properties",
          "prefix": "online-mode="
        }
      },
      {
        "key": "view_distance",
        "label": "Sichtweite (Chunks)",
        "type": "number",
        "default": 10,
        "min": 3,
        "max": 32,
        "target": {
          "kind": "file_line",
          "file": "/data/server.properties",
          "prefix": "view-distance="
        }
      },
      {
        "key": "whitelist",
        "label": "Whitelist aktiv",
        "type": "bool",
        "default": false,
        "target": {
          "kind": "file_line",
          "file": "/data/server.properties",
          "prefix": "white-list="
        }
      }
    ]
  },
  "advanced": {
    "plugins": {
      "enabled": true,
      "label": "Plugins",
      "path": "/data/plugins",
      "restart_after_change": true,
      "sources": [
        {
          "id": "modrinth",
          "name": "Modrinth",
          "loader": "paper",
          "game_versions": [
            "1.21.5"
          ]
        },
        {
          "id": "spiget",
          "name": "SpigotMC"
        }
      ]
    }
  },
  "import": {
    "label": "Vorhandenen Java-Server übernehmen (Welt + Einstellungen)",
    "signature": [
      "eula.txt",
      "server.properties"
    ],
    "search": [
      "/opt/minecraft",
      "/opt/minecraft/*",
      "/srv/minecraft",
      "/srv/minecraft/*",
      "/home/*/minecraft",
      "/home/*/minecraft/*",
      "/root/minecraft",
      "/root/minecraft/*",
      "/opt/*/minecraft",
      "/var/minecraft",
      "/minecraft",
      "/home/*/mc",
      "/opt/mc",
      "/var/lib/docker/volumes/*/_data",
      "/opt/*-data",
      "/opt/*/data",
      "/srv/*/data",
      "/home/*/*/data",
      "/home/*/mc-data",
      "/srv/mc"
    ],
    "properties": "server.properties",
    "level_env": "LEVEL"
  },
  "delegate": {
    "fields": [
      "max_players",
      "motd",
      "gamemode",
      "difficulty",
      "pvp",
      "view_distance",
      "whitelist"
    ],
    "actions": [
      "plugins"
    ],
    "caps": [
      "ram_mb",
      "cpu"
    ]
  },
  "audience": "homelab"
}