{
  "id": "bookstack-25",
  "group": "bookstack",
  "name": "BookStack",
  "version": "25.12",
  "category": "Wissen",
  "icon": "📗",
  "summary": "Wiki und Doku, organisiert wie Bücher",
  "description": "",
  "runtime": "docker",
  "image": "lscr.io/linuxserver/bookstack:version-v25.12.9",
  "container_port": 80,
  "protocol": "tcp",
  "http": true,
  "default_exposure": "external",
  "data": {
    "container_path": "/config",
    "label": "Konfiguration + Uploads"
  },
  "env": {
    "PUID": "1000",
    "PGID": "1000",
    "TZ": "Europe/Berlin",
    "APP_URL": "https://{domain}"
  },
  "database": {
    "default": "mariadb",
    "choices": [
      "mariadb"
    ],
    "env": {
      "mariadb": {
        "DB_HOST": "{db_host}",
        "DB_PORT": "3306",
        "DB_DATABASE": "{db_name}",
        "DB_USERNAME": "{db_user}",
        "DB_PASSWORD": "{db_password}"
      }
    }
  },
  "fields": {
    "required": [
      {
        "key": "app_key",
        "label": "App-Schlüssel",
        "type": "password",
        "required": false,
        "generate": true,
        "auto": "password",
        "help": "Interner Verschlüsselungsschlüssel — wird automatisch erzeugt.",
        "target": {
          "kind": "env",
          "name": "APP_KEY",
          "format": "{value:x<32}"
        }
      }
    ],
    "specific": []
  },
  "advanced": {},
  "notes": [
    "Erste Anmeldung: admin@admin.com / password — danach sofort ändern."
  ],
  "audience": "server"
}