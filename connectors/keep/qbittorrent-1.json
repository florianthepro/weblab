  "env": {
    "PUID": "1000",
    "PGID": "1000",
    "TZ": "Europe/Berlin",
    "WEBUI_PORT": "8080"
  },
  "notes": [
    "Das erste Anmeldepasswort steht einmalig im Container-Log (Logs der App).",
    "Downloads landen im Datenordner unter downloads/."
  ],
