{
  "id": "2fauth-8",
  "group": "2fauth",
  "name": "2FAuth",
  "version": "8",
  "category": "Sicherheit",
  "icon": "🔑",
  "summary": "Verwaltet Zwei-Faktor-Codes (TOTP) zentral im Browser",
  "description": "",
  "runtime": "docker",
  "image": "2fauth/2fauth:8.0.1",
  "container_port": 8000,
  "protocol": "tcp",
  "http": true,
  "default_exposure": "external",
  "data": {
    "container_path": "/2fauth",
    "label": "2FAuth-Daten"
  },
  "data_owner": "1000:1000",
  "env": {
    "APP_URL": "https://{domain}",
    "TRUSTED_PROXIES": "*"
  },
  "fields": {
    "required": [
      {
        "key": "app_key",
        "label": "App-Schlüssel",
        "type": "password",
        "required": false,
        "generate": true,
        "auto": "password",
        "help": "Interner Verschlüsselungsschlüssel — wird automatisch erzeugt.",
        "target": {
          "kind": "env",
          "name": "APP_KEY",
          "format": "{value:x<32}"
        }
      }
    ],
    "specific": []
  },
  "advanced": {},
  "notes": [
    "Speichert in SQLite im Datenverzeichnis — keine separate Datenbank nötig.",
    "Nach der Installation zuerst ein eigenes Konto registrieren."
  ],
  "audience": "homelab"
}