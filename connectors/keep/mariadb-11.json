{
  "id": "mariadb-11",
  "group": "mariadb",
  "name": "MariaDB",
  "version": "11",
  "category": "Datenbanken",
  "icon": "🐬",
  "summary": "Datenbank (MySQL-kompatibel)",
  "description": "",
  "runtime": "docker",
  "image": "mariadb:11",
  "container_port": 3306,
  "protocol": "tcp",
  "http": false,
  "default_exposure": "internal",
  "data": {
    "container_path": "/var/lib/mysql",
    "label": "Datenbank-Dateien"
  },
  "env": {},
  "fields": {
    "required": [
      {
        "key": "db_name",
        "label": "Datenbank-Name",
        "type": "string",
        "default": "app",
        "required": true,
        "target": {
          "kind": "env",
          "name": "MARIADB_DATABASE"
        }
      },
      {
        "key": "db_user",
        "label": "Benutzer",
        "type": "string",
        "default": "app",
        "required": true,
        "target": {
          "kind": "env",
          "name": "MARIADB_USER"
        }
      },
      {
        "key": "db_password",
        "label": "Passwort",
        "type": "password",
        "required": true,
        "generate": true,
        "help": "Leer lassen = sicheres Passwort wird erzeugt.",
        "target": {
          "kind": "env",
          "name": "MARIADB_PASSWORD"
        }
      },
      {
        "key": "db_root_password",
        "label": "Root-Passwort",
        "type": "password",
        "required": true,
        "generate": true,
        "help": "Leer lassen = sicheres Passwort wird erzeugt.",
        "target": {
          "kind": "env",
          "name": "MARIADB_ROOT_PASSWORD"
        }
      }
    ],
    "specific": []
  },
  "advanced": {}
}
