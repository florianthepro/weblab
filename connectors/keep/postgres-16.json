{
  "id": "postgres-16",
  "group": "postgres",
  "name": "PostgreSQL",
  "version": "16",
  "category": "Datenbanken",
  "icon": "🐘",
  "summary": "Datenbank",
  "description": "",
  "runtime": "docker",
  "image": "postgres:16-alpine",
  "container_port": 5432,
  "protocol": "tcp",
  "http": false,
  "default_exposure": "internal",
  "data": {
    "container_path": "/var/lib/postgresql/data",
    "label": "Datenbank-Dateien"
  },
  "env": {},
  "fields": {
    "required": [
      {
        "key": "db_name",
        "label": "Datenbank-Name",
        "type": "string",
        "default": "app",
        "required": true,
        "target": {
          "kind": "env",
          "name": "POSTGRES_DB"
        }
      },
      {
        "key": "db_user",
        "label": "Benutzer",
        "type": "string",
        "default": "app",
        "required": true,
        "target": {
          "kind": "env",
          "name": "POSTGRES_USER"
        }
      },
      {
        "key": "db_password",
        "label": "Passwort",
        "type": "password",
        "required": true,
        "generate": true,
        "help": "Leer lassen = sicheres Passwort wird erzeugt.",
        "target": {
          "kind": "env",
          "name": "POSTGRES_PASSWORD"
        }
      }
    ],
    "specific": [
      {
        "key": "max_connections",
        "label": "Max. Verbindungen",
        "type": "number",
        "default": 100,
        "min": 10,
        "max": 1000,
        "target": {
          "kind": "env",
          "name": "POSTGRES_MAX_CONNECTIONS"
        }
      }
    ]
  },
  "advanced": {}
}
