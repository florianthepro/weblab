{
  "id": "minecraft-bedrock-1.21",
  "group": "minecraft-bedrock",
  "name": "Minecraft (Bedrock)",
  "version": "1.21",
  "category": "Spiele",
  "icon": "🟩",
  "summary": "Bedrock-Server für Handy, Konsole und Windows",
  "description": "",
  "runtime": "docker",
  "image": "itzg/minecraft-bedrock-server:2026.8.2",
  "container_port": 19132,
  "protocol": "udp",
  "http": false,
  "default_exposure": "external",
  "data": {
    "container_path": "/data",
    "label": "Weltdaten"
  },
  "env": {
    "EULA": "TRUE"
  },
  "fixed_ports": [
    {
      "port": 19132,
      "protocol": "udp"
    }
  ],
  "notes": [
    "Spieler verbinden sich auf UDP-Port 19132.",
    "Für Xbox/Switch braucht es je nach Netzwerk zusätzlich eine App wie BedrockConnect."
  ],
  "fields": {
    "required": [
      {
        "key": "max_players",
        "label": "Max. Spieler",
        "type": "number",
        "default": 10,
        "min": 1,
        "max": 100,
        "required": true,
        "target": {
          "kind": "env",
          "name": "MAX_PLAYERS"
        }
      }
    ],
    "specific": [
      {
        "key": "server_name",
        "label": "Servername (in der Liste)",
        "type": "string",
        "default": "weblab Bedrock",
        "target": {
          "kind": "env",
          "name": "SERVER_NAME"
        }
      },
      {
        "key": "gamemode",
        "label": "Spielmodus",
        "type": "select",
        "options": [
          "survival",
          "creative",
          "adventure"
        ],
        "default": "survival",
        "target": {
          "kind": "env",
          "name": "GAMEMODE"
        }
      },
      {
        "key": "difficulty",
        "label": "Schwierigkeit",
        "type": "select",
        "options": [
          "peaceful",
          "easy",
          "normal",
          "hard"
        ],
        "default": "easy",
        "target": {
          "kind": "env",
          "name": "DIFFICULTY"
        }
      },
      {
        "key": "allow_cheats",
        "label": "Cheats erlauben",
        "type": "bool",
        "default": false,
        "target": {
          "kind": "env",
          "name": "ALLOW_CHEATS"
        }
      },
      {
        "key": "online_mode",
        "label": "Xbox-Live-Konto verlangen",
        "type": "bool",
        "default": true,
        "help": "Aus = auch ohne Xbox-Konto beitreten (unsicher).",
        "target": {
          "kind": "env",
          "name": "ONLINE_MODE"
        }
      }
    ]
  },
  "advanced": {},
  "import": {
    "label": "Vorhandenen Bedrock-Server übernehmen (Welten + Einstellungen)",
    "signature": [
      "worlds",
      "server.properties"
    ],
    "signature_not": [
      "eula.txt"
    ],
    "search": [
      "/opt/minecraft",
      "/opt/minecraft/*",
      "/srv/minecraft",
      "/srv/minecraft/*",
      "/home/*/minecraft",
      "/home/*/minecraft/*",
      "/root/minecraft",
      "/root/minecraft/*",
      "/opt/*/minecraft",
      "/var/minecraft",
      "/minecraft",
      "/home/*/mc",
      "/opt/mc",
      "/var/lib/docker/volumes/*/_data",
      "/opt/*-data",
      "/opt/*/data",
      "/srv/*/data",
      "/home/*/*/data",
      "/home/*/mc-data",
      "/srv/mc"
    ],
    "properties": "server.properties",
    "level_env": "LEVEL_NAME",
    "properties_map": {
      "server-name": "server_name",
      "gamemode": "gamemode",
      "difficulty": "difficulty",
      "max-players": "max_players",
      "online-mode": "online_mode",
      "allow-cheats": "allow_cheats"
    }
  },
  "delegate": {
    "fields": [
      "max_players",
      "server_name",
      "gamemode",
      "difficulty",
      "allow_cheats"
    ],
    "actions": [],
    "caps": [
      "ram_mb",
      "cpu"
    ]
  },
  "audience": "homelab"
}