{
  "id": "photoprism-260728",
  "group": "photoprism",
  "name": "PhotoPrism",
  "version": "260728",
  "category": "Medien",
  "icon": "📷",
  "summary": "Fotoverwaltung mit KI-Suche",
  "description": "",
  "runtime": "docker",
  "image": "photoprism/photoprism:260728",
  "container_port": 2342,
  "protocol": "tcp",
  "http": true,
  "default_exposure": "external",
  "data": {
    "container_path": "/data",
    "label": "Fotos + Index"
  },
  "env": {
    "PHOTOPRISM_ORIGINALS_PATH": "/data/originals",
    "PHOTOPRISM_STORAGE_PATH": "/data/storage",
    "PHOTOPRISM_IMPORT_PATH": "/data/import",
    "PHOTOPRISM_SITE_URL": "https://{domain}/",
    "PHOTOPRISM_DISABLE_TLS": "true"
  },
  "database": {
    "default": "mariadb",
    "choices": [
      "mariadb"
    ],
    "env": {
      "mariadb": {
        "PHOTOPRISM_DATABASE_DRIVER": "mysql",
        "PHOTOPRISM_DATABASE_SERVER": "{db_host}:3306",
        "PHOTOPRISM_DATABASE_NAME": "{db_name}",
        "PHOTOPRISM_DATABASE_USER": "{db_user}",
        "PHOTOPRISM_DATABASE_PASSWORD": "{db_password}"
      }
    }
  },
  "fields": {
    "required": [
      {
        "key": "admin_user",
        "label": "Admin-Benutzer",
        "type": "string",
        "default": "admin",
        "required": false,
        "target": {
          "kind": "env",
          "name": "PHOTOPRISM_ADMIN_USER"
        },
        "auto": "user"
      },
      {
        "key": "admin_password",
        "label": "Admin-Passwort",
        "type": "password",
        "required": false,
        "generate": true,
        "target": {
          "kind": "env",
          "name": "PHOTOPRISM_ADMIN_PASSWORD"
        },
        "auto": "password"
      }
    ],
    "specific": []
  },
  "notes": [
    "Fotos in den Unterordner „originals“ unter „Dateien“ legen.",
    "Indizierung braucht viel Arbeitsspeicher — mindestens 4 GB empfohlen."
  ],
  "advanced": {},
  "audience": "homelab",
  "featured": true,
  "featured_rank": 4
}