{
  "id": "nextcloud-30",
  "group": "nextcloud",
  "name": "Nextcloud",
  "version": "30",
  "category": "Cloud",
  "icon": "☁️",
  "summary": "Cloud-Speicher, Kalender, Kontakte",
  "description": "",
  "runtime": "docker",
  "image": "nextcloud:30-apache",
  "container_port": 80,
  "protocol": "tcp",
  "http": true,
  "default_exposure": "external",
  "data": {
    "container_path": "/var/www/html",
    "label": "Nextcloud-Daten"
  },
  "env": {
    "OVERWRITEPROTOCOL": "https",
    "TRUSTED_PROXIES": "172.16.0.0/12",
    "APACHE_DISABLE_REWRITE_IP": "1",
    "NEXTCLOUD_TRUSTED_DOMAINS": "{domain} {server_ip}"
  },
  "database": {
    "default": "mariadb",
    "choices": ["mariadb", "sqlite"],
    "env": {
      "mariadb": {
        "MYSQL_HOST": "{db_host}",
        "MYSQL_DATABASE": "{db_name}",
        "MYSQL_USER": "{db_user}",
        "MYSQL_PASSWORD": "{db_password}"
      },
      "sqlite": {
        "SQLITE_DATABASE": "{db_name}"
      }
    }
  },
  "fields": {
    "required": [
      {
        "key": "admin_user",
        "label": "Admin-Benutzer",
        "type": "string",
        "default": "admin",
        "required": false,
        "target": {
          "kind": "env",
          "name": "NEXTCLOUD_ADMIN_USER"
        },
        "auto": "user"
      },
      {
        "key": "admin_password",
        "label": "Admin-Passwort",
        "type": "password",
        "required": false,
        "generate": true,
        "target": {
          "kind": "env",
          "name": "NEXTCLOUD_ADMIN_PASSWORD"
        },
        "auto": "password"
      }
    ],
    "specific": []
  },
  "advanced": {}
}
