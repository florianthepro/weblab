{
  "id": "nextcloud-30",
  "group": "nextcloud",
  "name": "Nextcloud",
  "version": "30",
  "category": "Cloud",
  "icon": "☁️",
  "summary": "Cloud-Speicher, Kalender, Kontakte",
  "description": "",
  "runtime": "docker",
  "image": "nextcloud:30-apache",
  "container_port": 80,
  "protocol": "tcp",
  "http": true,
  "default_exposure": "external",
  "data": {
    "container_path": "/var/www/html",
    "label": "Nextcloud-Daten"
  },
  "env": {
    "OVERWRITEPROTOCOL": "https",
    "TRUSTED_PROXIES": "172.16.0.0/12",
    "APACHE_DISABLE_REWRITE_IP": "1",
    "NEXTCLOUD_TRUSTED_DOMAINS": "{domain} {server_ip}"
  },
  "notes": [
    "Domain hier und im Feld „Domain“ gleich halten."
  ],
  "fields": {
    "required": [
      {
        "key": "admin_user",
        "label": "Admin-Benutzer",
        "type": "string",
        "default": "admin",
        "required": true,
        "target": {
          "kind": "env",
          "name": "NEXTCLOUD_ADMIN_USER"
        }
      },
      {
        "key": "admin_password",
        "label": "Admin-Passwort",
        "type": "password",
        "required": true,
        "generate": true,
        "help": "Leer lassen = sicheres Passwort wird erzeugt.",
        "target": {
          "kind": "env",
          "name": "NEXTCLOUD_ADMIN_PASSWORD"
        }
      }
    ],
    "specific": []
  },
  "advanced": {}
}
