{
  "id": "code-server-4",
  "group": "code-server",
  "name": "code-server",
  "version": "4",
  "category": "Werkzeuge",
  "icon": "💻",
  "summary": "VS Code im Browser",
  "description": "",
  "runtime": "docker",
  "image": "lscr.io/linuxserver/code-server:latest",
  "container_port": 8443,
  "protocol": "tcp",
  "http": true,
  "default_exposure": "external",
  "data": {
    "container_path": "/config",
    "label": "Arbeitsbereich + Einstellungen"
  },
  "env": {
    "PUID": "1000",
    "PGID": "1000",
    "TZ": "Europe/Berlin"
  },
  "fields": {
    "required": [
      {
        "key": "password",
        "label": "Zugangs-Passwort",
        "type": "password",
        "required": true,
        "generate": true,
        "target": {
          "kind": "env",
          "name": "PASSWORD"
        },
        "auto": "password"
      }
    ],
    "specific": []
  },
  "advanced": {}
}