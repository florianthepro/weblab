{
  "id": "yourls-1",
  "group": "yourls",
  "name": "YOURLS",
  "version": "1",
  "category": "Web",
  "icon": "🔗",
  "summary": "Eigener URL-Verkürzer mit Klick-Statistiken",
  "description": "",
  "runtime": "docker",
  "image": "yourls:1.9.2-apache",
  "container_port": 80,
  "protocol": "tcp",
  "http": true,
  "default_exposure": "external",
  "data": {
    "container_path": "/var/www/html",
    "label": "YOURLS-Dateien (Plugins, Konfiguration)"
  },
  "env": {
    "YOURLS_SITE": "https://{domain}"
  },
  "database": {
    "default": "mariadb",
    "choices": [
      "mariadb"
    ],
    "env": {
      "mariadb": {
        "YOURLS_DB_HOST": "{db_host}",
        "YOURLS_DB_NAME": "{db_name}",
        "YOURLS_DB_USER": "{db_user}",
        "YOURLS_DB_PASS": "{db_password}"
      }
    }
  },
  "fields": {
    "required": [
      {
        "key": "admin_user",
        "label": "Admin-Benutzer",
        "type": "string",
        "default": "admin",
        "required": false,
        "target": {
          "kind": "env",
          "name": "YOURLS_USER"
        },
        "auto": "user"
      },
      {
        "key": "admin_password",
        "label": "Admin-Passwort",
        "type": "password",
        "required": false,
        "generate": true,
        "target": {
          "kind": "env",
          "name": "YOURLS_PASS"
        },
        "auto": "password"
      }
    ],
    "specific": []
  },
  "advanced": {},
  "notes": [
    "Die Verwaltungsoberfläche ist unter /admin/ erreichbar — beim ersten Aufruf dort die Installation abschließen."
  ],
  "audience": "server"
}
