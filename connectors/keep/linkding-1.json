{
  "id": "linkding-1",
  "group": "linkding",
  "name": "linkding",
  "version": "1",
  "category": "Werkzeuge",
  "icon": "🔗",
  "summary": "Schlanker Lesezeichen-Manager mit Tags",
  "description": "",
  "runtime": "docker",
  "image": "sissbruecker/linkding:1.46.2",
  "container_port": 9090,
  "protocol": "tcp",
  "http": true,
  "default_exposure": "external",
  "data": {
    "container_path": "/etc/linkding/data",
    "label": "Lesezeichen-Datenbank"
  },
  "env": {
    "LD_CSRF_TRUSTED_ORIGINS": "https://{domain}"
  },
  "fields": {
    "required": [
      {
        "key": "admin_user",
        "label": "Admin-Benutzer",
        "type": "string",
        "default": "admin",
        "required": false,
        "target": {
          "kind": "env",
          "name": "LD_SUPERUSER_NAME"
        },
        "auto": "user"
      },
      {
        "key": "admin_password",
        "label": "Admin-Passwort",
        "type": "password",
        "required": false,
        "generate": true,
        "target": {
          "kind": "env",
          "name": "LD_SUPERUSER_PASSWORD"
        },
        "auto": "password"
      }
    ],
    "specific": []
  },
  "advanced": {},
  "audience": "homelab"
}