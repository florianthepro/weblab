{
  "id": "website-nginx-1.27",
  "group": "website-nginx",
  "manage_subdomain": "nginx",
  "name": "Webseite (Nginx)",
  "version": "1.27",
  "category": "Web",
  "icon": "🌐",
  "summary": "Webseite mit Nginx, PHP zuschaltbar",
  "description": "",
  "runtime": "docker",
  "image": "trafex/php-nginx:3.7.0",
  "container_port": 8080,
  "protocol": "tcp",
  "http": true,
  "data": {
    "container_path": "/var/www/html",
    "label": "Webseiten-Dateien"
  },
  "data_owner": "1000:1000",
  "env": {},
  "manager": {
    "label": "SFTPGo",
    "image": "drakkan/sftpgo:v2.7.5",
    "container_port": 8080,
    "mount": "/srv/sftpgo/data/site",
    "data": "/var/lib/sftpgo",
    "data_owner": "1000:1000",
    "username": "webmaster",
    "env": {
      "SFTPGO_DATA_PROVIDER__CREATE_DEFAULT_ADMIN": "1",
      "SFTPGO_DEFAULT_ADMIN_USERNAME": "admin",
      "SFTPGO_DEFAULT_ADMIN_PASSWORD": "{manager_password}",
      "SFTPGO_LOADDATA_FROM": "/var/lib/sftpgo/init-users.json"
    },
    "files": [
      {
        "path": "init-users.json",
        "content": "{\"users\":[{\"username\":\"{manager_user}\",\"password\":\"{manager_password}\",\"status\":1,\"home_dir\":\"/srv/sftpgo/data/site\",\"permissions\":{\"/\":[\"*\"]}}]}"
      }
    ]
  },
  "init_files": [
    {
      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"de\">\n<meta charset=\"utf-8\">\n<title>{index_title}</title>\n<h1>{index_title}</h1>\n<p>Diese Webseite läuft über weblab.</p>\n<p>Dateien verwaltest du über das Verwaltungs-Dashboard (SFTPGo) auf der Verwaltungs-Domain dieser App. PHP lässt sich unter <b>Einstellungen → Spezifisch</b> aktivieren.</p>\n"
    }
  ],
  "notes": [
    "Dateien verwaltest du über SFTPGo auf der Verwaltungs-Domain — Anmeldung mit den Zugangsdaten unten.",
    "Admin-Oberfläche von SFTPGo: /web/admin (Benutzer admin, gleiches Passwort).",
    "PHP unter Einstellungen → Spezifisch einschalten."
  ],
  "fields": {
    "required": [
      {
        "key": "index_title",
        "label": "Titel der Startseite",
        "type": "string",
        "default": "Meine Webseite",
        "required": true,
        "help": "Wird beim Anlegen in die index.html geschrieben — später frei änderbar.",
        "target": {
          "kind": "none"
        }
      }
    ],
    "specific": [
      {
        "key": "php_enabled",
        "label": "PHP aktivieren",
        "type": "bool",
        "default": false,
        "help": "Aus = reine statische Seite. An = .php-Dateien werden ausgeführt (PHP 8.3).",
        "target": {
          "kind": "file_line",
          "file": "/etc/php83/conf.d/zz-weblab.ini",
          "prefix": "engine = "
        }
      },
      {
        "key": "php_memory_limit",
        "label": "PHP Speicherlimit",
        "type": "select",
        "options": [
          "128M",
          "256M",
          "512M",
          "1024M"
        ],
        "default": "256M",
        "help": "Nur wirksam, wenn PHP aktiviert ist.",
        "target": {
          "kind": "file_line",
          "file": "/etc/php83/conf.d/zz-weblab.ini",
          "prefix": "memory_limit = "
        }
      },
      {
        "key": "php_upload_max",
        "label": "Max. Upload-Größe",
        "type": "select",
        "options": [
          "8M",
          "32M",
          "128M",
          "512M"
        ],
        "default": "32M",
        "target": {
          "kind": "file_line",
          "file": "/etc/php83/conf.d/zz-weblab.ini",
          "prefix": "upload_max_filesize = "
        }
      },
      {
        "key": "php_display_errors",
        "label": "PHP-Fehler anzeigen",
        "type": "select",
        "options": [
          "Off",
          "On"
        ],
        "default": "Off",
        "help": "Im Betrieb aus lassen — Fehlermeldungen verraten interne Details.",
        "target": {
          "kind": "file_line",
          "file": "/etc/php83/conf.d/zz-weblab.ini",
          "prefix": "display_errors = "
        }
      }
    ]
  },
  "advanced": {},
  "audience": "server"
}