{
  "id": "gotify-2",
  "group": "gotify",
  "name": "Gotify",
  "version": "2",
  "category": "Monitoring",
  "icon": "🔔",
  "summary": "Selbst gehostete Push-Benachrichtigungen mit Apps und API",
  "description": "",
  "runtime": "docker",
  "image": "gotify/server:2.9.1",
  "container_port": 80,
  "protocol": "tcp",
  "http": true,
  "default_exposure": "external",
  "data": {
    "container_path": "/app/data",
    "label": "Gotify-Daten"
  },
  "env": {},
  "fields": {
    "required": [
      {
        "key": "admin_password",
        "label": "Admin-Passwort",
        "type": "password",
        "required": false,
        "generate": true,
        "target": {
          "kind": "env",
          "name": "GOTIFY_DEFAULTUSER_PASS"
        },
        "auto": "password"
      }
    ],
    "specific": []
  },
  "advanced": {},
  "notes": [
    "Anmeldung mit Benutzer „admin“ und dem erzeugten Passwort."
  ],
  "audience": "server"
}