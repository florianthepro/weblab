# Optionale Konfiguration — kopiere diese Datei nach box.env:
#   cp box.env.example box.env
# box.env ist per .gitignore ausgeschlossen (keine Secrets ins Repo!).
#
# Verwaltungs-Domain, Admin-Konto und Cloudflare-Token werden NICHT hier gesetzt,
# sondern im Setup-Assistenten im Browser (http://<server-ip>).

# Extra-Datenlaufwerk (optional): Blockgerät (z. B. /dev/sdb) wird formatiert (falls leer)
# und dauerhaft nach DATA_MOUNT gemountet. Steht danach als Ablageort für App-Daten bereit.
DATA_MOUNT=/mnt/data
DATA_DEVICE=

# Optional: ed25519-Public-Key. Ist er gesetzt, wird SSH auf key-only gehärtet
# (root-/Passwort-Login aus, neuer sudo-User "ops"). Leer = SSH bleibt unverändert.
ADMIN_SSH_PUBKEY=
