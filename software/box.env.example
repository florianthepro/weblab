# Konfiguration — kopiere diese Datei nach box.env und trage deine Werte ein:
#   cp box.env.example box.env
# box.env ist per .gitignore ausgeschlossen (keine Secrets ins Repo!).
# Alternativ leer lassen: run.sh fragt DOMAIN und CF_TOKEN beim Setup interaktiv ab.

# Manage-Domain (z.B. example.com). Apex zeigt per A-Record auf die Server-IP.
DOMAIN=

# Cloudflare API-Token mit Rechten "Zone.DNS:Edit" für die Domain.
# Optional: leer lassen und den A-Record manuell setzen. Ist der Token IP-gebunden,
# muss er die IP dieses Servers erlauben (sonst schlägt die DNS-Automatik fehl).
CF_TOKEN=

# Extra-Datenlaufwerk (optional): Blockgerät (z.B. /dev/sdb) wird formatiert (falls leer)
# und dauerhaft nach DATA_MOUNT gemountet.
DATA_MOUNT=/mnt/data
DATA_DEVICE=

# Optional: ed25519-Public-Key. Ist er gesetzt, wird SSH auf key-only gehärtet
# (root-/Passwort-Login aus, neuer sudo-User "ops"). Leer = SSH bleibt unverändert.
ADMIN_SSH_PUBKEY=
