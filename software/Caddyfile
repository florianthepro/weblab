{
	admin 127.0.0.1:2019
	on_demand_tls {
		ask http://127.0.0.1:8099/api/tls-ask
	}
}

# Start-Konfiguration: Panel immer verschlüsselt (interne CA, self-signed) — egal
# über welche IP der Server angesprochen wird (on_demand stellt das Zertifikat beim
# Verbinden aus; weblab erlaubt das nur für IP-Adressen). Schon Setup und erste
# Anmeldung laufen so nie über Klartext. Sobald im Setup eine Domain gesetzt wird,
# schreibt weblab diese Datei neu (Let's Encrypt für die Domain + Routen je App).
https:// {
	tls internal {
		on_demand
	}
	reverse_proxy 127.0.0.1:8099
}

http:// {
	redir https://{host}{uri} temporary
}
